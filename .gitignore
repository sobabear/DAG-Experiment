# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Secrets & run outputs
.env
results/
!apps/implementation-comparison/results/
apps/implementation-comparison/results/**
!apps/implementation-comparison/results/research-30/
apps/implementation-comparison/results/research-30/**
!apps/implementation-comparison/results/research-30/comparison.md
!apps/implementation-comparison/results/POISON_RESULTS.md
# Poison run summaries (small: per-task flags + rates) so code/01..04 can be re-run from a clone.
# Full transcript/artifact trees under results/poison*/<system>/ stay ignored.
!apps/implementation-comparison/results/poison*/
apps/implementation-comparison/results/poison*/**
!apps/implementation-comparison/results/poison*/score.json
!apps/implementation-comparison/results/poison*/comparison.md
.worktrees/

# LaTeX build artifacts (paper sources and official ACL style files stay tracked)
apps/implementation-comparison/paper/*.aux
apps/implementation-comparison/paper/*.bbl
apps/implementation-comparison/paper/*.blg
apps/implementation-comparison/paper/*.fdb_latexmk
apps/implementation-comparison/paper/*.fls
apps/implementation-comparison/paper/*.log
apps/implementation-comparison/paper/*.out
apps/implementation-comparison/paper/*.pdf
